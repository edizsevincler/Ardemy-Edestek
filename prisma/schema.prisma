// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  GUEST
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

enum QuestionType {
  TOPIC    // Konu anlatımı
  QUESTION // Soru (açık uçlu)
  QUIZ     // Çoktan seçmeli test (20 soruluk)
}

enum QuizOption {
  A
  B
  C
  D
}

enum SessionType {
  PACKAGE         // sayılı oturum paketi (sessionsRemaining kullanılır)
  UNLIMITED       // sınırsız
  PAY_PER_SESSION // günlük/derste ödemeli, paket takibi yok
}

model User {
  id                String      @id @default(cuid())
  username          String?     @unique
  email             String?     @unique
  emailVerified     DateTime?
  passwordHash      String
  name              String
  role              Role        @default(STUDENT)
  createdAt         DateTime    @default(now())
  lastLoginAt       DateTime?
  sessionType       SessionType @default(PACKAGE)
  sessionsRemaining Int         @default(0)
  credits           Int         @default(0)

  // Duolingo tarzı günlük seri: her gün en az bir soru/test çözünce artar,
  // bir gün atlanırsa bir sonraki aktivitede 1'e sıfırlanır.
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastStreakDate   DateTime?
  lastRewardStreak Int       @default(0)

  // Seri koruma: kaçırılan bir günde seriyi otomatik kurtarır (bkz. lib/streak.ts).
  streakFreezes Int @default(0)

  // Mağaza: satın alınan unvan/çerçeveler (UserCosmetic) ve şu an takılı
  // olanlar. Tanımlar kodda (lib/cosmetics.ts), burada yalnızca id tutulur.
  // Kayıt anında siteye hangi kanaldan gelindiği (ör. "instagram", "tiktok").
  // Bkz. lib/source.ts ve /admin/sources. Boşsa kaynak bilinmiyor/doğrudan.
  signupSource String?

  // Arayüz/e-posta dili ("tr" | "en" | "ru"). Kayıtta ve dil seçilince güncellenir.
  locale String @default("tr")

  equippedTitle String?
  equippedFrame String?

  // Arkadaşını getir sistemi: referralCode ilk ziyarette üretilip
  // atanır (bkz. lib/referral.ts). Ödül, davet edilenin İLK onaylanan
  // kredi alışverişinde bir kereye mahsus verilir (referralRewardGiven).
  referralCode        String? @unique
  referredById        String?
  referredBy          User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]  @relation("Referrals")
  referralRewardGiven Boolean @default(false)

  // Günün Sorusu hangi dilden gelsin (ör. "Rusça"). Boşsa tüm dillerden
  // karışık; o dilde yayında test yoksa da karışık seçime düşer.
  dailyLanguage String?

  // Hatırlatma e-postaları (seri uyarısı, ilk test daveti). Kullanıcı e-postadaki
  // "abonelikten çık" linkiyle kapatabilir; hesap/şifre e-postaları etkilenmez.
  emailReminders Boolean @default(true)

  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  lessonFiles           LessonFile[]
  messages              Message[]
  creditPurchases       CreditPurchase[]
  unlockedQuestions     QuestionUnlock[]
  questionAnswers       QuestionAnswer[]
  quizSubmissions       QuizSubmission[]
  verificationTokens    VerificationToken[]
  streakRewards         StreakReward[]
  dailyAnswers          DailyQuestionAnswer[]
  cosmetics             UserCosmetic[]
  examAttempts          ExamAttempt[]
  passwordResets        PasswordResetToken[]
  badges                UserBadge[]
  emailLogs             EmailLog[]
  questionReports       QuestionReport[]
}

// GUEST kaydı sırasında e-postanın gerçekten kullanıcıya ait olduğunu
// doğrulamak için gönderilen tek kullanımlık link token'ı.
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  fileName    String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id          String   @id @default(cuid())
  fileUrl     String
  fileName    String
  note        String?
  submittedAt DateTime @default(now())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model LessonFile {
  id         String    @id @default(cuid())
  title      String
  fileUrl    String
  fileName   String
  lessonDate DateTime?
  uploadedAt DateTime  @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Bir öğrencinin eğitmenle olan tüm sohbeti tek `studentId` altında tutulur
// (eğitmen tek kişi olduğu için ayrı bir "konuşma" tablosuna gerek yok).
// `senderRole` mesajı kimin yazdığını, `read` ise karşı tarafın okuyup
// okumadığını belirtir.
model Message {
  id         String   @id @default(cuid())
  body       String
  senderRole Role
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// `subject` is a free-form string (not an enum) on purpose: the tutor plans to
// add subjects beyond ENGLISH/RUSSIAN later without needing a schema migration.
model Question {
  id          String       @id @default(cuid())
  type        QuestionType @default(QUESTION)
  title       String
  subject     String
  body        String?
  fileUrl     String?
  fileName    String?
  pageCount   Int?
  creditCost  Int      @default(1)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  unlocks         QuestionUnlock[]
  answers         QuestionAnswer[]
  quizItems       QuizItem[]
  quizSubmissions QuizSubmission[]
}

// Bir QUIZ tipi Question'a bağlı tek bir çoktan seçmeli soru.
model QuizItem {
  id      String     @id @default(cuid())
  order   Int
  prompt  String
  optionA String
  optionB String
  optionC String
  optionD String
  correct QuizOption

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
}

// Bir kullanıcının bir QUIZ'i tamamlamasının sonucu. `answers` her maddenin
// seçilen şıkkını ve doğru olup olmadığını tutar (ör: [{"itemId":"...",
// "selected":"B","correct":true}, ...]) — tekrar çözmeye izin verilir, yeni
// gönderim eskisinin üzerine yazılır (unique).
// "Günün Sorusu": her gün herkese ücretsiz tek bir test sorusu gösterilir
// (bkz. lib/daily-question.ts). Kullanıcı başına günde bir cevap hakkı var;
// `dateKey` İstanbul saatine göre YYYY-MM-DD. quizItemId bilerek FK değil —
// soru sonradan silinse bile cevap geçmişi (rozet sayacı) bozulmasın.
model DailyQuestionAnswer {
  id         String     @id @default(cuid())
  dateKey    String
  quizItemId String
  selected   QuizOption
  correct    Boolean
  answeredAt DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// Kazanılan rozetler kalıcı tutulur (test tekrar çözülünce skor değişse veya
// zamana bağlı rozetlerde kayıp olmasın) ve "yeni rozet" kutlaması için
// ilk kazanılma anı bilinir. Rozet tanımları kodda: lib/badges.ts.
model UserBadge {
  id       String   @id @default(cuid())
  badgeId  String
  earnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model QuizSubmission {
  id          String   @id @default(cuid())
  score       Int
  total       Int
  answers     Json
  submittedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

// Bir kullanıcının açtığı soruya verdiği cevap. Tekrar göndermeye izin
// verilir (dil pratiği için deneme-yanılma doğaldır) — yeni gönderim eski
// geri bildirimi geçersiz kılar, bu yüzden tek kayıt üstüne yazılır (unique).
model QuestionAnswer {
  id          String    @id @default(cuid())
  body        String?
  fileUrl     String?
  fileName    String?
  submittedAt DateTime  @default(now())
  feedback    String?
  gradedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

// Bir kullanıcının kredisiyle açtığı (kilidini kaldırdığı) soru — ödeme değil,
// kredi harcama kaydıdır. Aynı soruyu iki kez açamasın diye unique.
model QuestionUnlock {
  id         String   @id @default(cuid())
  unlockedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

// Bir kullanıcının 30 günün katı bir seriye ulaşması (30, 60, 90...) burada
// kayıt olur — eğitmen admin panelinden görüp ödülü (ör. 40 dk hediye ders)
// elden verdikten sonra `fulfilled` işaretler.
model StreakReward {
  id          String    @id @default(cuid())
  streakDays  Int
  createdAt   DateTime  @default(now())
  fulfilled   Boolean   @default(false)
  fulfilledAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditPackage {
  id        String   @id @default(cuid())
  name      String
  credits   Int
  priceTRY  Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases CreditPurchase[]
}

// Gerçek para karşılığında kredi satın alma kaydı (iyzico burada devreye
// girecek). `credits`/`amount` satın alma anındaki paket değerinin
// anlık görüntüsüdür — paket sonradan değişse bile geçmiş kayıt bozulmaz.
model CreditPurchase {
  id              String         @id @default(cuid())
  credits         Int
  amount          Decimal        @db.Decimal(10, 2)
  status          PurchaseStatus @default(PENDING)
  iyzicoPaymentId String?
  createdAt       DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  packageId String
  package   CreditPackage @relation(fields: [packageId], references: [id])
}

// Mağazadan satın alınmış bir unvan veya çerçeve.
model UserCosmetic {
  id          String   @id @default(cuid())
  itemId      String
  purchasedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// Deneme sınavı havuzu: soru bankasındaki testlerden (QuizItem) BAĞIMSIZ,
// yalnızca deneme sınavında kullanılan özgün sorular. `correct` istemciye
// sınav bitmeden gönderilmez.
model ExamQuestion {
  id          String     @id @default(cuid())
  language    String // "İngilizce" | "Rusça"
  topic       String
  prompt      String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  correct     QuizOption
  explanation String?
  createdAt   DateTime   @default(now())

  @@unique([language, prompt])
  @@index([language])
}

// Satın alınmış bir deneme sınavı. Sorular başlangıçta sabitlenir
// (`questionIds`); süre `startedAt`'tan sunucu tarafında hesaplanır.
// `answers`: [{ questionId, selected: "A"|null, correct: bool }, ...]
model ExamAttempt {
  id          String    @id @default(cuid())
  language    String
  questionIds Json
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  total       Int
  answers     Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// Şifre sıfırlama: e-postadaki ham token yerine yalnızca SHA-256 özeti saklanır
// (veritabanı sızsa bile link üretilemez). Süre: 1 saat, tek kullanımlık.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Ziyaret sayacı: kişi veya cihaz tanımlayıcısı TUTULMAZ; yalnızca gün/sayfa/
// kaynak/dil bazında toplam sayfa görüntüleme sayısı (bkz. /admin/visits).
// `source` boş kaynak için "" olarak saklanır (benzersizlik kısıtı için).
model PageViewDaily {
  day    String // YYYY-MM-DD (İstanbul)
  path   String
  source String @default("")
  locale String @default("tr")
  count  Int    @default(0)

  @@id([day, path, source, locale])
}

// Hatalı giriş denemeleri: aynı kullanıcı adı/e-posta için 15 dakikada 8 hatalı
// denemeden sonra giriş geçici olarak kilitlenir (şifre tahminini zorlaştırır).
model LoginThrottle {
  key         String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())
}

// Gönderilen hatırlatma/karşılama e-postalarının kaydı: aynı e-posta aynı
// kullanıcıya aynı gün (veya tek seferlikse hiç) ikinci kez gitmesin diye.
model EmailLog {
  id     String   @id @default(cuid())
  kind   String // "welcome" | "first-test" | "streak-risk"
  dayKey String   @default("") // günlük e-postalarda YYYY-MM-DD, tek seferliklerde boş
  sentAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, dayKey])
}

// Öğrencilerin "soruyu bildir" ile gönderdiği hatalı/belirsiz soru bildirimleri.
// Soru metni o anki haliyle snapshot'ta saklanır (soru sonradan düzenlense
// veya silinse de yönetici neyin bildirildiğini görebilsin).
model QuestionReport {
  id         String    @id @default(cuid())
  kind       String // "quiz" (QuizItem) | "exam" (ExamQuestion)
  itemId     String
  reason     String
  note       String?
  snapshot   Json
  status     String    @default("OPEN") // "OPEN" | "RESOLVED"
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, itemId])
  @@index([status, createdAt])
}
